# Production template — copy to backend/.env and fill in.

# Inside docker-compose, "mongo" is the container hostname
MONGO_URL=mongodb://mongo:27017
DB_NAME=n0ct_blog

# Set to your public URL (or leave * for LAN-only quick starts)
CORS_ORIGINS=https://blog.example.com

# Your Emergent Universal Key. Powers the AI TL;DR feature.
# Get / top up from: Emergent dashboard -> Profile -> Manage Plan -> Universal Key
EMERGENT_LLM_KEY=sk-emergent-REPLACE_ME

# Generate with:  openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
