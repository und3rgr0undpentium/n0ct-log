# Public URL the site will be reached at. Caddy uses this for HTTPS.
# Examples:
#   PUBLIC_HOST=blog.example.com     -> auto Let's Encrypt HTTPS
#   PUBLIC_HOST=:80                  -> plain HTTP on LAN (no domain needed)
PUBLIC_HOST=blog.example.com

# What the React app will call. Match your PUBLIC_HOST.
#   With domain + HTTPS:  https://blog.example.com
#   LAN only:             http://192.168.1.50    (your VM's IP)
PUBLIC_URL=https://blog.example.com
